# Mika-owned components shared by the application and the model-free test build.
get_filename_component(MIKA_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
option(MIKA_SANITIZERS "Instrument Mika-owned code with AddressSanitizer and UBSan" OFF)
function(mika_warnings target)
    if(MIKA_SANITIZERS AND NOT MSVC)
        target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
        target_link_options(${target} PUBLIC -fsanitize=address,undefined)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /utf-8)
        target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wshadow)
        target_compile_definitions(${target} PRIVATE _POSIX_C_SOURCE=200809L)
        if(APPLE)
            # Keep safe-open/flock extensions visible alongside POSIX on Darwin.
            target_compile_definitions(${target} PRIVATE _DARWIN_C_SOURCE=1)
        endif()
    endif()
endfunction()

add_library(mika_platform STATIC "${MIKA_SOURCE_DIR}/src/platform.c")
target_include_directories(mika_platform PUBLIC "${MIKA_SOURCE_DIR}/src" "${CMAKE_BINARY_DIR}/generated")
if(WIN32)
    target_link_libraries(mika_platform PUBLIC shell32 ole32 uuid)
endif()
mika_warnings(mika_platform)

add_library(mika_assets STATIC "${MIKA_SOURCE_DIR}/src/assets.cpp")
target_include_directories(mika_assets PUBLIC "${MIKA_SOURCE_DIR}/src")
mika_warnings(mika_assets)

# Offline asset validation has no downloader/network dependency.
add_library(mika_verify STATIC "${MIKA_SOURCE_DIR}/src/verify.c")
target_link_libraries(mika_verify PUBLIC mika_platform OpenSSL::Crypto)
mika_warnings(mika_verify)
add_library(mika_model STATIC "${MIKA_SOURCE_DIR}/src/model.c")
target_link_libraries(mika_model PUBLIC mika_verify CURL::libcurl)
mika_warnings(mika_model)

add_library(mika_pcm STATIC "${MIKA_SOURCE_DIR}/src/pcm.c")
target_include_directories(mika_pcm PUBLIC "${MIKA_SOURCE_DIR}/src")
mika_warnings(mika_pcm)

add_library(mika_punctuation_guard STATIC "${MIKA_SOURCE_DIR}/src/punctuation.c")
target_include_directories(mika_punctuation_guard PUBLIC "${MIKA_SOURCE_DIR}/src")
mika_warnings(mika_punctuation_guard)
set_target_properties(mika_punctuation_guard PROPERTIES POSITION_INDEPENDENT_CODE ON)
add_library(mika_fullstop_render STATIC "${MIKA_SOURCE_DIR}/src/fullstop_render.cpp")
target_link_libraries(mika_fullstop_render PUBLIC mika_punctuation_guard)
set_target_properties(mika_fullstop_render PROPERTIES POSITION_INDEPENDENT_CODE ON)
mika_warnings(mika_fullstop_render)
